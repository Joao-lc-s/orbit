rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasEmail() {
      return signedIn() && request.auth.token.email is string;
    }

    function isAdmin() {
      return hasEmail()
        && exists(/databases/$(database)/documents/allowed_users/$(request.auth.token.email))
        && get(/databases/$(database)/documents/allowed_users/$(request.auth.token.email)).data.isAdmin == true;
    }

    function isAllowedUser() {
      return hasEmail()
        && exists(/databases/$(database)/documents/allowed_users/$(request.auth.token.email));
    }

    // Cada conta acessa somente seu próprio estado, chunks, arquivos e widgets.
    match /artifacts/orbit-v7/users/{userId}/{document=**} {
      allow read, write: if isAllowedUser() && request.auth.uid == userId;
    }

    // O usuário pode consultar somente sua própria autorização. Listar e editar
    // a lista inteira exige um documento isAdmin=true para o e-mail autenticado.
    match /allowed_users/{email} {
      allow get: if hasEmail() && request.auth.token.email == email;
      allow list, create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
